DJANGO_ENV=development
SECRET_KEY=django-insecure-warehouse-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web,warehouse_web

# Database (PostgreSQL for Docker, SQLite for local dev if DB_HOST not set)
DB_NAME=warehouse_db
DB_USER=warehouse_user
DB_PASSWORD=warehouse_password
DB_HOST=
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://127.0.0.1:6379/2
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Service Account Credentials (used by Project A to authenticate)
SERVICE_ACCOUNT_USERNAME=bookshop_service
SERVICE_ACCOUNT_PASSWORD=warehouse_secret_pass_2026
