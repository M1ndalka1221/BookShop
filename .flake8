[flake8]
max-line-length = 120
exclude =
    .git,
    __pycache__,
    */migrations/*,
    .venv,
    venv,
    htmlcov,
    .pytest_cache,
    docs,
    staticfiles,
    .agents,
    .superpowers
ignore = E203, W503, E704
per-file-ignores =
    core/settings/*: F401,F403,F405,E402
    core/__init__.py: F401
